<Project>
  <!--
    Shared TIMF build paths.
    Override Terraria reference with:
      - env TIMF_TERRARIA  (absolute path to Terraria.exe), or
      - MSBuild property -p:TimfTerrariaRef=<absolute path>
  -->
  <PropertyGroup>
    <TimfRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</TimfRepoRoot>
    <TimfXnaDir>$(TimfRepoRoot)lib\xna</TimfXnaDir>
    <TimfLibDir>$(TimfRepoRoot)lib</TimfLibDir>

    <!-- Keep local checkout paths out of generated PDB/source metadata. -->
    <DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
    <PathMap Condition="'$(PathMap)' == ''">$(TimfRepoRoot)=/_/TIMF_SOURCE</PathMap>

    <!-- Resolve only from explicit configuration or the repository-local compile reference.
         This keeps machine-specific install locations out of the repository. -->
    <TimfTerrariaRef Condition="'$(TimfTerrariaRef)' == '' and '$(TIMF_TERRARIA)' != ''">$(TIMF_TERRARIA)</TimfTerrariaRef>
    <TimfTerrariaRef Condition="'$(TimfTerrariaRef)' == '' and Exists('$(TimfLibDir)\Terraria.exe')">$(TimfLibDir)\Terraria.exe</TimfTerrariaRef>
    <!-- Last resort so csproj still has a HintPath (build will fail with a clear missing-file error). -->
    <TimfTerrariaRef Condition="'$(TimfTerrariaRef)' == ''">$(TimfLibDir)\Terraria.exe</TimfTerrariaRef>
  </PropertyGroup>

  <!-- Convenience ItemGroups projects can import via <Import> is automatic for Directory.Build.props properties only.
       Each csproj still declares Reference items using $(TimfXnaDir) / $(TimfTerrariaRef). -->
</Project>
